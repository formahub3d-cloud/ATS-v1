# ─── ATS API — variabili d'ambiente (NON committare il .env reale) ───
# Copia in `.env` e compila. In produzione: variabili su Railway.

NODE_ENV=development
PORT=8080

# MongoDB Atlas (tier M0 in dev). Stringa di connessione completa.
MONGODB_URI=mongodb://127.0.0.1:27017/ats

# Segreti JWT: generane di robusti (es. `openssl rand -hex 32`). MAI committarli.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-长
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS: origine del frontend (Vite dev / dominio prod dietro Cloudflare).
CORS_ORIGIN=http://localhost:3000
